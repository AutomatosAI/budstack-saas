// ─────────────────────────────────────────────────────────────────────────────
// PRD-205 / PRD-208 — users.email SINGLE-TENANT ASSUMPTION (load-bearing).
//
// `email @unique` is GLOBAL and `tenantId` is nullable, so a given human can exist
// in AT MOST ONE tenant. lib/tenant-resolver.ts's Clerk/email fallback is only
// UNAMBIGUOUS because of this constraint — resolving a tenant by email alone is safe
// only while one email => one tenant. (The resolver still returns a typed
// AmbiguousTenantResolution for >1 active match so it stays correct after the change
// below; today that path is simply unreachable.)
//
// PRD-208 MIGRATION SPEC (specified here, NOT executed in PRD-205 — no schema change
// in this PRD):
//   GOAL: per-tenant user uniqueness — replace the global `email @unique` with a
//         composite `@@unique([email, tenantId])` so the same email can onboard into
//         multiple tenants (one users row per tenant).
//   SCHEMA: drop `@unique` on `email`; add `@@unique([email, tenantId])` to this model.
//   DATA BACKFILL (do BEFORE adding the composite constraint):
//     - Postgres treats NULLs as DISTINCT in a unique index, so `@@unique([email,
//       tenantId])` would NOT prevent duplicate emails among rows with tenantId = NULL.
//       Decide null policy: either backfill every users.tenantId to a non-null tenant,
//       or keep platform/super-admin users null AND add a partial unique index
//       `CREATE UNIQUE INDEX ... ON users(email) WHERE tenantId IS NULL` to keep
//       platform-level emails globally unique.
//     - Detect & resolve existing (email) collisions before the cutover (there are none
//       today because of the global unique, but the migration must assert it).
//   CLERK MAPPING: post-migration one Clerk identity (one email) may legitimately map to
//     >1 tenant; lib/tenant-resolver.ts's email fallback then returns
//     AmbiguousTenantResolution, which PRD-203's getCurrentUser surfaces as a 403. The
//     active Clerk org (settings.clerkOrgId) becomes the disambiguator, so the clerk-org
//     branch MUST be preferred over the email branch (already the case in the resolver).
// ─────────────────────────────────────────────────────────────────────────────
model users {
  id                  String                    @id
  email               String                    @unique // PRD-208: -> @@unique([email, tenantId]); see note above
  clerkUserId         String?                   @unique // PRD-213: reliable Clerk->local mapping for user.deleted erasure
  password            String
  name                String?
  role                Role                      @default(PATIENT)
  teamRole            String? // PRD-301: team permission-set selector (admin|editor|customer_support|web_designer|manager). NULL => legacy full-access admin (pre-teams). Only meaningful for TENANT_ADMIN rows.
  tenantId            String? // PRD-208 backfill target; nullable today => global-unique email is load-bearing
  drGreenClientId     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime
  resetToken          String?                   @unique
  resetTokenExpiry    DateTime?
  firstName           String?
  lastName            String?
  phone               String?
  address             Json?
  isActive            Boolean                   @default(true)
  marketingConsentAt  DateTime? // Email Phase 2 (US-016/US-023): when this customer opted in to marketing. NULL = no consent, never mail them a campaign.
  reorderReminderAt   DateTime? // US-028: when the reorder-reminder automation last mailed this customer. NULL = never. The once-per-window guard is a conditional write against this column.
  reorderReminderToken String?  @unique // US-028: this customer's permanent opt-out credential for the reorder reminder. Minted on the first reminder and never rotated — the link lives in an inbox and has to keep working.
  consultations       consultations[]
  customer_tags       customer_tags[] // US-024 CRM-lite tags; rows cascade away with the user
  drgreen_carts       drgreen_carts?
  orders              orders[]
  posts               posts[]
  reviewedSubmissions marketplace_submissions[]
  tenants             tenants?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId]) // PRD-208 AC-4: tenant-scoped user lookups ($use auto-scopes by tenantId)
}

// PRD-301: per-tenant permission matrix. One row per (tenant, preset role); each
// boolean gates a feature. Seeded with sensible defaults at tenant creation and
// editable by tenant admins — except the `admin` role, which is always all-true.
model role_permissions {
  id                   String   @id @default(uuid())
  tenantId             String
  role                 String // admin | editor | customer_support | web_designer | manager
  canViewCustomers     Boolean  @default(false)
  canEditCustomers     Boolean  @default(false)
  canExportCustomers   Boolean  @default(false)
  canDeleteCustomer    Boolean  @default(false)
  canViewOrders        Boolean  @default(false)
  canEditOrders        Boolean  @default(false)
  canViewProducts      Boolean  @default(false)
  canEditProducts      Boolean  @default(false)
  canDeleteProducts    Boolean  @default(false)
  canViewAnalytics     Boolean  @default(false)
  canEditSettings      Boolean  @default(false)
  canManageBranding    Boolean  @default(false)
  canInviteTeamMembers Boolean  @default(false)
  canDeleteTeamMembers Boolean  @default(false)
  canViewAuditLogs     Boolean  @default(false)
  canViewCRM           Boolean  @default(false)
  canViewEmails        Boolean  @default(false)
  canEditEmails        Boolean  @default(false)
  canViewTemplates     Boolean  @default(false)
  canEditTemplates     Boolean  @default(false)
  canViewSeo           Boolean  @default(false)
  canEditSeo           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenants              tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
  @@index([tenantId])
}

// PRD-301: team member invitations. Email + secure token; Clerk handles the
// eventual sign-up, our accept endpoint links the new users row to the tenant.
// One row per (tenant, email) — re-invites upsert this row (reset token/status/expiry).
model team_invitations {
  id              String    @id @default(uuid())
  tenantId        String
  email           String
  role            String // admin | editor | customer_support | web_designer | manager
  invitationToken String    @unique
  invitedBy       String // Clerk user id of the inviting admin (matches audit_logs.userId convention)
  status          String    @default("pending") // pending | accepted | expired | revoked
  acceptedAt      DateTime?
  expiresAt       DateTime // set by app at creation (sentAt + 7 days)
  sentAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())
  tenants         tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

// PRD-302: super-admin impersonation sessions. NOT tenant-scoped in lib/db.ts —
// this is a cross-tenant support table, only ever reached through withSuperAdmin
// (which binds tenant context to an explicit null) or the auth-helper resolver.
// `tokenHash` is the SHA-256 of the cookie bearer token; the raw token is never
// persisted, so a DB read can't be replayed as a session cookie. At most ONE
// active (endedAt IS NULL) session per super-admin — enforced by a partial
// unique index in the migration (Prisma can't express partial indexes).
model impersonation_sessions {
  id                  String    @id
  superAdminClerkId   String // Clerk user id of the support person (audit_logs.userId convention)
  superAdminEmail     String
  tenantId            String
  tenantEmail         String? // owner-admin email snapshot at session start (tenants has no email column)
  tokenHash           String    @unique
  startedAt           DateTime  @default(now())
  expiresAt           DateTime // startedAt + IMPERSONATION_MAX_HOURS (default 4h)
  endedAt             DateTime?
  endedReason         String? // manual | timeout | replaced | tenant_inactive | super_admin_deleted
  superAdminIpAddress String?
  notes               String? // optional support reason, shown in the sessions table
  createdAt           DateTime  @default(now())
  tenants             tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([superAdminClerkId, endedAt])
  @@index([tenantId, startedAt])
}

model webhook_deliveries {
  id           String    @id
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  response     String?
  success      Boolean   @default(false)
  attemptCount Int       @default(1)
  nextRetry    DateTime?
  createdAt    DateTime  @default(now())
  webhooks     webhooks  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([success, nextRetry])
  @@index([webhookId, createdAt])
