generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id         String   @id
  action     String
  entityType String
  entityId   String?
  userId     String?
  userEmail  String?
  tenantId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  impersonationSessionId String? // PRD-302: set when the action was performed inside a super-admin impersonation session
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([impersonationSessionId]) // PRD-302: "view everything support did in this session"
}

model email_logs {
  id           String      @id @default(uuid())
  tenantId     String
  recipient    String
  subject      String
  templateName String
  status       EmailStatus @default(QUEUED)
  smtpResponse String?
  errorMessage String?
  metadata     String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenants      tenants     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
}

model email_templates {
  id          String                 @id @default(uuid())
  name        String
  subject     String
  contentHtml String
  contentJson Json?
  description String?
  category    String                 @default("transactional")
  isSystem    Boolean                @default(false)
  isActive    Boolean                @default(true)
  tenantId    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  mappings    email_event_mappings[]
  tenants     tenants?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
}

model email_event_mappings {
  id         String          @id @default(uuid())
  eventType  String
  tenantId   String?
  templateId String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  template   email_templates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenants    tenants?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventType, tenantId])
}

// Storefront newsletter list. Double opt-in: a signup lands PENDING and only
// becomes CONFIRMED when the emailed token is followed, so the list stays
// consented and deliverable. `token` is the single credential behind both the
// confirm and the unsubscribe link, so it is globally unique and rotated on use.
model newsletter_subscribers {
  id             String           @id @default(uuid())
  tenantId       String
  email          String
  status         SubscriberStatus @default(PENDING)
  source         String? // where the signup came from, e.g. "storefront-cta"
  consentAt      DateTime? // when the visitor asked to subscribe
  confirmedAt    DateTime? // when the opt-in token was followed
  unsubscribedAt DateTime?
  token          String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenants        tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

/// Addresses this tenant must never send MARKETING email to (Email Phase 2,
/// US-004). Checked by the worker before every marketing send; transactional
/// mail (order confirmations, password resets) is deliberately unaffected — an
/// opt-out is not a request to stop being told about your own order.
///
/// One row per address is the whole contract: the reason is provenance, not a
/// filter, so a bounced address is suppressed exactly as hard as an
/// unsubscribed one and re-suppressing keeps the first reason recorded.
model email_suppressions {
  id        String            @id @default(uuid())
  tenantId  String
  email     String
  reason    SuppressionReason
  createdAt DateTime          @default(now())
  tenants   tenants           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

/// One-off marketing send — a newsletter or a blog digest (Email Phase 2,
/// US-016). Authored exactly like a template: `contentJson` is the composer
/// document and `contentHtml` is what the US-011 pipeline derived from it, so
/// the worker's Handlebars step consumes it unchanged.
///
/// `audience` is the *rule* (which lists to mail), never the resolved list —
/// recipients are materialised into campaign_recipients at send time so the
/// count reflects consent and suppression as they stand then, not at draft time.
/// `stats` is a denormalised progress cache for the list view; the recipient
/// rows remain the source of truth.
model campaigns {
  id          String                @id @default(uuid())
  tenantId    String
  name        String
  subject     String
  contentHtml String
  contentJson Json?
  status      CampaignStatus        @default(DRAFT)
  audience    Json? // null = audience not chosen yet
  scheduledAt DateTime?
  /// US-021: the BullMQ trigger this campaign is waiting on, or null when it is
  /// waiting on nothing. Authoritative over the queue — Redis and Postgres are
  /// not written atomically, so a trigger that fires checks whether it is still
  /// the one named here before it sends anything. That is what makes
  /// rescheduling a replacement rather than a second send.
  scheduledJobId String?
  sentAt      DateTime?
  stats       Json? // null = never sent
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tenants     tenants               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients  campaign_recipients[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One row per address a campaign fans out to (Email Phase 2, US-016), created
/// at send time. This is the per-recipient delivery record: exactly one message
/// per row, never a multi-address To:.
///
/// `userId` and `emailLogId` are plain columns rather than relations on purpose
/// — the recipient row must outlive an erased customer or a pruned log row, and
/// `users` is load-bearing (PRD-208) so it gains no back-relation here.
model campaign_recipients {
  id               String                  @id @default(uuid())
  campaignId       String
  email            String
  userId           String? // customer this address belongs to, when it is one
  status           CampaignRecipientStatus @default(PENDING)
  emailLogId       String? // US-008 linkage: the email_logs row carrying the outcome
  error            String?
  /// US-019: this recipient's own opt-out credential, minted at fan-out and put
  /// in the footer link. Per-recipient rather than per-subscriber because a
  /// campaign also reaches consented customers who have no subscriber row at
  /// all, and because it is what attributes an unsubscribe to a campaign
  /// (US-026). Nullable only so the column could be added to an existing table.
  unsubscribeToken String?                 @unique
  /// US-026: when this recipient redeemed the token above, or null. Stamped by
  /// `unsubscribeByToken` at the moment the link is followed, because the token
  /// is the ONLY thing that ties an opt-out to the message that caused it —
  /// `email_suppressions` records that an address left the list, never which
  /// email it left from. First redemption wins: the link stays live in an inbox
  /// forever and following it again must not move the timestamp.
  unsubscribedAt   DateTime?
  /// US-027: FIRST open and FIRST click, or null. Timestamps rather than
  /// counters on purpose — "did this person engage, and when" is the whole
  /// question the results page asks, and a per-open counter would turn an
  /// inbox that re-fetches images on every scroll into a behavioural log
  /// nobody consented to. Written only while the tenant's
  /// `emailTrackingEnabled` setting is on; first write wins, so a link
  /// followed again months later never restates an old engagement as new.
  openedAt         DateTime?
  clickedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  campaigns        campaigns               @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/// CRM-lite customer tag (Email Phase 2, US-024): one row per
/// (tenant, customer, tag). `tag` is stored normalised — trimmed, lowercased —
/// so "VIP" and " vip " are the same chip everywhere; the compound unique key
/// makes re-adding a tag idempotent at the database, not just in the route.
///
/// Unlike campaign_recipients above, `userId` here IS a relation with Cascade:
/// a tag is targeting metadata with no life of its own, so it must die with the
/// user row rather than outlive it. (GDPR erasure anonymises the row in place,
/// so erased customers keep their tags but are filtered from every surface.)
/// `@@index([tenantId, tag])` serves the customers-list tag filter and US-025's
/// "has tag" segment axis.
model customer_tags {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  tag       String
  createdAt DateTime @default(now())
  tenants   tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, tag])
  @@index([tenantId, tag])
}

/// A reusable audience filter (Email Phase 2, US-025) — "customers who have not
/// ordered in 60 days", written once and pointed at by any number of campaigns.
///
/// A segment is a RULE and never a list. It names no addresses, so a campaign
/// that resolves it in April reaches whoever matches in April — the same
/// contract `campaigns.audience` keeps, and the reason neither column can hold
/// a stale set of people.
///
/// `filter` is a Json COLUMN but is NOT free-form Json: it holds the criterion
/// union declared in lib/email/segment-filter.ts, re-parsed on every read. A
/// rule this version cannot understand resolves to NOBODY rather than to
/// everybody, so a filter written by a later version can never widen a send.
///
/// `@@unique([tenantId, name])` is what stops "Reorder 60d" existing four times
/// in one store's audience picker.
model segments {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  filter    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants   tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model conditions {
  id              String   @id
  slug            String
  name            String
  description     String?
  image           String?
  category        String
  categoryKey     String
  causes          Json?
  symptoms        Json?
  types           Json?
  treatments      Json?
  medicalCannabis Json?
  faqs            Json?
  published       Boolean  @default(true)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  seo             Json?
  tenants         tenants  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model consultation_questionnaires {
  id                    String   @id
  tenantId              String?
  firstName             String
  lastName              String
  email                 String
  phoneCode             String
  phoneNumber           String
  dateOfBirth           DateTime
  gender                String
  password              String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String
  countryCode           String
  businessType          String?
  businessName          String?
  businessAddress1      String?
  businessAddress2      String?
  businessCity          String?
  businessState         String?
  businessPostalCode    String?
  businessCountry       String?
  businessCountryCode   String?
  // Article 9 special-category health data was REMOVED from this model on
  // 2026-07-27 (migration 20260727000000_drop_article9_health_columns).
  // BudStacks forwards health answers to Dr Green from the request body and
  // does not retain them — Dr Green is the controller for the clinical record.
  // Do NOT re-add health fields here; see lib/security/article9.ts and
  // docs/PRDS/prd-data-protection-remediation.md.
  drGreenClientId       String?
  submittedToDrGreen    Boolean  @default(false)
  submissionError       String?
  kycLink               String?
  isKycVerified         Boolean  @default(false)
  adminApproval         String   @default("PENDING")
  // PRD-220 Part B — inline ID-document upload OUTCOME (SA ID-upload mode).
  // Status flag only, never document data. UPLOADED | UPLOAD_FAILED | null.
  idDocumentStatus      String?
  idDocumentError       String?
  idDocumentUpdatedAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime
}

/// Per-tenant controller identity, merged into the BudStacks-managed privacy
/// policy template and served on the tenant's own domain. Operators are
/// controllers of their storefront's patient data and must publish a notice
/// naming themselves — serving the BudStacks corporate policy does not
/// discharge their Art. 13 duty.
///
/// The policy BODY is NOT stored here: it is a versioned template owned by
/// BudStacks (lib/legal/privacy-template.ts) so counsel reviews one document
/// rather than one per tenant. Tenants supply merge values only.
///
/// See docs/PRDS/prd-data-protection-remediation.md (WS2).
model tenant_legal_profiles {
  id                    String    @id
  tenantId              String    @unique
  tenants               tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  controllerLegalName   String
  registeredAddress     String
  privacyContactEmail   String
  icoRegistrationNumber String?
  dpoName               String?
  dpoContact            String?
  ukRepresentative      String?
  /// Commercial + regulatory details used by the terms and regulatory
  /// documents. Nullable: a document whose required fields are absent serves
  /// the fallback rather than rendering half a legal page.
  tradingName           String?
  supportContactEmail   String?
  governingLaw          String?
  deliveryTerms         String?
  returnsPolicy         String?
  licenceNumber         String?
  regulatorName         String?
  /// Template version stamped at publish time; null until first publish.
  templateVersion       String?
  /// Null means never published — the storefront serves the fallback notice.
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
}

/// Per-document publishing state for a tenant's legal pages.
///
/// A tenant either accepts the BudStacks-maintained default for a document or
/// supplies their own text. The choice is per DOCUMENT, not per tenant: an
/// operator will commonly accept the cookie notice and write their own terms,
/// because terms are their commercial contract.
///
/// The operator is the controller and these are their documents, so writing
/// their own is theirs to do. What matters is that the choice is recorded —
/// which mode, when, and by whom — so responsibility for the wording is never
/// ambiguous in either direction.
///
/// Updates to a default reach only tenants on `default`. That is the whole
/// value of accepting it.
///
/// See docs/PRDS/prd-data-protection-remediation.md.
model tenant_legal_documents {
  id                      String    @id
  tenantId                String
  /// privacy | terms | cookies | regulatory
  slug                    String
  /// default = inherit the maintained template. custom = this tenant's own text.
  mode                    String    @default("default")
  /// Markdown, used only in custom mode. Null while on the default.
  body                    String?
  /// Null means not published — the storefront serves the fallback notice.
  publishedAt             DateTime?
  /// Template version in force at publish time (default mode only).
  templateVersion         String?
  /// Recorded when a tenant switches to custom and accepts that the wording,
  /// and keeping it current, is theirs.
  responsibilityAcceptedAt     DateTime?
  responsibilityAcceptedByUserId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime

  tenants                 tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// The BudStacks-maintained default text for each legal document.
///
/// Database-backed so wording can be corrected without a deploy — when counsel
/// or a DPO reviews these, their revisions should not need a developer. The
/// code templates in lib/legal/documents remain the seed and the fallback, so
/// an empty table degrades to the shipped text rather than to nothing.
model platform_legal_templates {
  /// privacy | terms | cookies | regulatory
  slug            String   @id
  title           String
  body            String
  version         String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

/// Append-only ledger of data-protection purges. Each row records what was
/// destroyed and the counts captured immediately before destruction, so the
/// evidence trail lives in the database rather than in a file that can be
/// edited after the fact. Written by migrations, never by application code.
model compliance_purge_records {
  id         String   @id
  purgeName  String
  executedAt DateTime @default(now()) @db.Timestamptz(6)
  details    Json
}

/// Vendors BudStacks engages to deliver the platform (GDPR Art. 28(2)/(4)).
///
/// Database-backed rather than hardcoded so the list can change without a
/// deploy, and — more importantly — so adding or replacing a vendor can start
/// the 30-day notice clock the DPA promises operators. A list nobody can change
/// without an engineer is a list that silently goes stale.
///
/// See docs/PRDS/prd-data-protection-remediation.md (WS3, US-011).
model subprocessors {
  id                String   @id
  name              String
  purpose           String
  region            String
  transferMechanism String
  dpaUrl            String?
  /// pending = announced, not yet in force. active = processing. retired = gone.
  status            String   @default("pending")
  /// The date processing may begin. Must be >= 30 days after announcedAt
  /// unless a super admin overrides, which is written to the audit log.
  effectiveFrom     DateTime
  /// When operators were notified. Null until the notification job has run.
  announcedAt       DateTime?
  /// Set when status becomes retired, so the register keeps its history.
  retiredAt         DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  objections        subprocessor_objections[]

  @@index([status, effectiveFrom])
}

/// An operator's objection to a sub-processor, per DPA §6. Recorded against the
/// specific vendor rather than left in an inbox — an objection that cannot be
/// evidenced is one the operator cannot rely on.
model subprocessor_objections {
  id             String   @id
  subprocessorId String
  tenantId       String
  raisedByUserId String?
  reason         String
  /// open | acknowledged | resolved | withdrawn
  status         String   @default("open")
  /// True when raised more than 14 days after announcement (DPA §6 window).
  outOfWindow    Boolean  @default(false)
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  subprocessor   subprocessors @relation(fields: [subprocessorId], references: [id], onDelete: Cascade)
  tenants        tenants       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subprocessorId, status])
  @@index([tenantId])
}

model consultations {
  id        String             @id
  userId    String
  tenantId  String
  status    ConsultationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime
  tenants   tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     users              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model drgreen_carts {
  id            String   @id
  userId        String   @unique
  tenantId      String
  drGreenCartId String?
  items         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  tenants       tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model drgreen_webhook_logs {
  id              String    @id
  tenantId        String
  webhookType     String
  orderId         String?
  drGreenOrderId  String?
  drGreenClientId String?
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  tenants         tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([drGreenOrderId])
  @@index([drGreenClientId])
  @@index([tenantId, processed])
}

model kyc_journey_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String
  clientId    String
  email       String?
  eventType   String
  eventSource String   @default("drgreen-webhook")
  eventData   Json?
  createdAt   DateTime @default(now())
  tenants     tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([eventType])
}

model order_items {
  id          String   @id
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())
  orders      orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model orders {
  id                String        @id
  userId            String
  tenantId          String
  total             Float
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  notes             String?
  orderNumber       String        @unique
  shippingCost      Float         @default(5.00)
  shippingInfo      Json?
  subtotal          Float
  status            OrderStatus   @default(PENDING)
  drGreenOrderId    String?
  drGreenInvoiceNum String?
  paymentStatus     PaymentStatus @default(PENDING)
  paymentInvoices   Json?
  nonce             String?
  adminNotes        String?
  order_items       order_items[]
  tenants           tenants       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([drGreenOrderId])
  @@index([nonce])
  @@index([tenantId, createdAt]) // PRD-208 AC-4: admin orders list / analytics hot path
}

model platform_config {
  id                 String   @id @default("config")
  drGreenApiUrl      String?
  awsBucketName      String?
  awsFolderPrefix    String?
  awsRegion          String?
  awsAccessKeyId     String?
  awsSecretAccessKey String?
  emailServer        String?
  emailFrom          String?
  redisUrl           String?
  updatedAt          DateTime
  createdAt          DateTime @default(now())
}

model platform_settings {
  id                     String   @id @default("platform")
  businessName           String   @default("BudStacks")
  tagline                String?
  logoUrl                String?
  faviconUrl             String?
  primaryColor           String   @default("#059669")
  secondaryColor         String   @default("#34d399")
  accentColor            String   @default("#10b981")
  backgroundColor        String   @default("#ffffff")
  textColor              String   @default("#1f2937")
  headingColor           String   @default("#111827")
  fontFamily             String   @default("inter")
  headingFontFamily      String   @default("inter")
  template               String   @default("modern")
  automatosApiKey        String?
  automatosAgentId       Int?
  automatosHelperAgentId Int?
  updatedAt              DateTime
  pageSeo                Json?
  seo                    Json?
}

model posts {
  id         String   @id
  title      String
  slug       String
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  tenantId   String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  seo        Json?
  users      users    @relation(fields: [authorId], references: [id])
  tenants    tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug, tenantId])
}

model products {
  id              String      @id
  name            String
  slug            String
  drGreenStrainId String? // canonical Dr Green strain UUID (catalog parity / stable cart id)
  description     String?
  category     String
  strainType   StrainType?
  thcContent   Float?
  cbdContent   Float?
  price        Float
  stock        Int         @default(0)
  images       String[]
  tenantId     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  displayOrder Int         @default(0)
  seo          Json?
  deletedAt    DateTime? // PRD-208 soft-delete (recoverable; NULL = live)
  tenants      tenants     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug, tenantId])
  @@index([tenantId, deletedAt]) // PRD-208 soft-delete: tenant-scoped not-deleted filter
  @@index([tenantId, drGreenStrainId])
}

model templates {
  id                     String                    @id
  name                   String
  description            String?
  isActive               Boolean                   @default(true)
  isPublic               Boolean                   @default(true)
  ownerId                String?
  sourceType             String                    @default("SYSTEM")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime
  assetsPath             String?
  author                 String?
  category               String                    @default("modern")
  componentsPath         String?
  demoUrl                String?
  downloadCount          Int                       @default(0)
  isPremium              Boolean                   @default(false)
  layoutFilePath         String?
  metadata               Json?
  packagePath            String?
  previewUrl             String?
  price                  Float?
  slug                   String?                   @unique
  stylesPath             String?
  tags                   String[]
  thumbnailUrl           String?
  usageCount             Int                       @default(0)
  version                String                    @default("1.0.0")
  authorTenantId         String?
  authorName             String?
  deletedAt              DateTime? // PRD-208 soft-delete (recoverable; NULL = live)
  tenant_templates       tenant_templates[]
  tenants                tenants[]
  authorTenant           tenants?                  @relation("AuthoredTemplates", fields: [authorTenantId], references: [id])
  approvedForSubmissions marketplace_submissions[]

  @@index([deletedAt]) // PRD-208 soft-delete: keep "not-deleted" filters fast
}

model tenant_branding {
  id             String   @id
  tenantId       String   @unique
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#10b981")
  secondaryColor String   @default("#059669")
  accentColor    String   @default("#34d399")
  fontFamily     String   @default("Inter")
  createdAt      DateTime @default(now())
  updatedAt      DateTime
