model webhooks {
  id                 String               @id
  tenantId           String?
  url                String
  events             String[]
  secret             String
  isActive           Boolean              @default(true)
  description        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  webhook_deliveries webhook_deliveries[]

  @@index([tenantId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// PENDING     — signed up, opt-in token not yet followed (never mail marketing to these)
// CONFIRMED   — double opt-in complete; the only mailable state
// UNSUBSCRIBED— the subscriber opted out
// SUPPRESSED  — the platform stopped mailing them (bounce/complaint/manual)
enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
  SUPPRESSED
}

/// Why an address is suppressed. Lower-case on purpose: unlike the other enums
/// here these values are also the wire values the API and the audit trail use,
/// and US-004 pins them as `unsubscribed | bounced | manual`.
enum SuppressionReason {
  unsubscribed
  bounced
  manual
}

// DRAFT     — being authored; editable
// SCHEDULED — scheduledAt set and a delayed job is armed; still editable/cancellable
// SENDING   — recipients materialised and fanned out to the queue
// SENT      — no PENDING/QUEUED recipients remain
// CANCELLED — terminal; the worker refuses to send a job for this campaign
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// PENDING    — materialised, not yet enqueued
// QUEUED     — a job exists for this recipient
// SENT/FAILED— the worker's outcome (detail lives on the linked email_logs row)
// SUPPRESSED — blocked at send time by the tenant suppression list (US-004)
enum CampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

enum ConsultationStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PENDING_SYNC
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AWAITING_PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  OVERPAID
  UNDERPAID
}

