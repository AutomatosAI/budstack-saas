exports[`renderEmailBody > renders a deterministic document for a fixture tenant 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><!--$--><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="background-color:#f4f4f5;margin:0;padding-top:0;padding-bottom:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f4f4f5;font-family:Helvetica, Arial, sans-serif;color:#1f2937;margin:0;padding-top:24px;padding-bottom:24px"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;background-color:#ffffff;width:100%;margin:0 auto;border-radius:8px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#7c3aed;height:4px;width:100%;font-size:1px;line-height:1px"><tbody><tr><td> </td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:24px;padding-bottom:8px;padding-left:32px;padding-right:32px;text-align:center"><tbody><tr><td><img alt="Healing Buds" height="48" src="https://shop.example/api/public/images/development/tenants/tenant-a/uploads/1712-logo.png" style="display:block;outline:none;border:none;text-decoration:none;height:48px;margin:0 auto"/></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:8px;padding-bottom:8px;padding-left:32px;padding-right:32px"><tbody><tr><td><div style="font-family:Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1f2937"><h1>Autumn drop</h1><p>Three new strains are in stock.</p></div></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-width:1px;border-style:solid;border-color:#e5e7eb;margin-top:24px;margin-bottom:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding-top:16px;padding-bottom:24px;padding-left:32px;padding-right:32px"><tbody><tr><td><p style="font-size:12px;line-height:18px;font-family:Helvetica, Arial, sans-serif;color:#6b7280;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Healing Buds</p><p style="font-size:12px;line-height:18px;font-family:Helvetica, Arial, sans-serif;color:#6b7280;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">1 Sample Street, Dublin, D01 X4X4, Ireland</p><p style="font-size:12px;line-height:18px;font-family:Helvetica, Arial, sans-serif;color:#6b7280;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0"><a href="{{unsubscribeUrl}}" rel="noopener noreferrer" style="color:#6b7280;text-decoration-line:none;font-size:12px;text-decoration:underline" target="_blank">Unsubscribe</a> <!-- -->from marketing email.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></body></html><!--/$-->"`;
