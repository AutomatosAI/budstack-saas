# ============================================
# BudStack — Environment Variable Reference
# ============================================
# Documents the variable NAMES the app requires. Values here are redacted
# placeholders only. Real secrets live in Railway (prod + staging) and in
# your local, gitignored .env — never commit real values.
#
# Replace every CHANGE_ME / placeholder before running locally.

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=budstack
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budstack_db
# Local: postgresql://USER:PASSWORD@localhost:5432/DB
# Railway: reference var ${{Postgres-BudStack.DATABASE_URL}}
DATABASE_URL=postgresql://budstack:CHANGE_ME@localhost:5432/budstack_db

# ============================================
# Redis (BullMQ queues, caching)
# ============================================
# Railway: reference var ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# ============================================
# Clerk (authentication)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_FRONTEND_API=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# AWS S3 (template + tenant asset storage)
# ============================================
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=budstack-uploads
AWS_FOLDER_PREFIX=development/
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ============================================
# Dr Green API (payments / consultations)
# ============================================
DRGREEN_API_URL=https://api.drgreen.com
DRGREEN_API_KEY=CHANGE_ME
DRGREEN_SECRET_KEY=CHANGE_ME

# ============================================
# Encryption
# ============================================
# Master key that decrypts every tenant's Dr Green payment-signing key.
# Generate with: openssl rand -hex 32 — rotate via the versioned-key flow.
ENCRYPTION_KEY=CHANGE_ME

# ============================================
# Email
# ============================================
EMAIL_FROM=noreply@your-domain.com

# ============================================
# Health monitoring
# ============================================
# Bearer token that unlocks detailed /api/health output (memory, uptime,
# per-service status). Leave unset to expose only { status } to all callers.
HEALTH_DETAIL_TOKEN=

# ============================================
# Next.js public config
# ============================================
NEXT_PUBLIC_BASE_DOMAIN=budstacks.io
NEXT_IMAGE_UNOPTIMIZED=false
